NEXT_PUBLIC_URL=

NEXT_PUBLIC_GRAPHQL_URL=
# WebSocket URL for Hasura subscriptions (use wss:// in production, ws:// for local dev)
# Example: wss://hasura.socratics.ai/v1/graphql (prod) or ws://localhost:8081/v1/graphql (dev)
NEXT_PUBLIC_HASURA_WS_URL=
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_REDIRECT_URI=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
AUTH0_CLIENT_SECRET=

# DEPRECATED (SENG-791): the sidebar "Compose" link now derives from
# NEXT_PUBLIC_COMPOSE_BASE_URL via composeUrl.ts (composeUploadUrl()). This var
# was wired into no build pipeline, so it always fell back to the Vercel
# prototype. Left here only to document the removal; do not set it.
# NEXT_PUBLIC_COMPOSE_URL=

# Mount base for the v2-frontend (Compose) app. Drives every projects-page
# handoff and the sidebar Compose link via src/lib/composeUrl.ts. It carries
# v2-frontend's /workflow basePath, so it is NOT origin-only in hosted envs.
# Per environment:
#   Local dev:        http://localhost:3001   (v2-frontend dev port, cross-origin)
#   Hosted (dev/prod): /workflow              (same-origin; App Gateway routes
#                                              /workflow/* → v2-frontend)
# Empty -> relative /multidoc-preview, which would resolve inside Agora and 404;
# always set it. See SENG-791.
NEXT_PUBLIC_COMPOSE_BASE_URL=

# Server Actions encryption key - must be 32-byte base64 encoded key
# Generate with: openssl rand -base64 32
# IMPORTANT: Keep this stable across deployments to prevent stale action ID errors
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# CosmosDB — canonical financial-model document store, now the source of truth
# for the projects directory (GET /api/directory/projects reads it). Same
# instance/container as v2-frontend. Dev uses the local Cosmos emulator
# (self-signed cert; the client sets NODE_TLS_REJECT_UNAUTHORIZED=0 in dev).
#   Local dev:  COSMOS_ENDPOINT=https://localhost:8081 + the emulator key
#   Dev DB/container: COSMOS_DATABASE=socratics-documents, COSMOS_CONTAINER=financial_models
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=
COSMOS_CONTAINER=

# Postgres — used by /api/auth/profile (user profile updates).
# Connection string for the users/tenants database.
# Use a least-privilege read-write role scoped to the users table.
DATABASE_URL=
# TLS CA certificate for the Postgres server (Azure Database for PostgreSQL).
# Base64-encode the PEM file: base64 -w0 /path/to/ca.pem
# When set, the server certificate is verified against this pinned CA.
# When unset, the system CA bundle is trusted (correct for prod/staging on Azure).
# Download the DigiCert root cert from: https://dl.cacerts.digicert.com/DigiCertGlobalRootCA.crt.pem
DATABASE_CA_CERT=
# Set to "true" in .env.local ONLY to disable TLS verification for local dev
# (e.g. a local Postgres instance without a trusted cert). Never set in staging
# or production — omitting it uses ssl:true (system CA), which is safe.
ALLOW_INSECURE_DB_TLS=
